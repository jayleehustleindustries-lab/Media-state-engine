DATABASE_URL=postgresql://user:password@host:5432/database

# API auth (either name works; MEDIA_ENGINE_API_KEY wins if both set)
API_KEY=
MEDIA_ENGINE_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_WEBHOOK_SECRET=

HEYGEN_API_KEY=
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_WEBHOOK_SECRET=
# Explicit HeyGen callback; else PUBLIC_BASE_URL + /webhooks/heygen
HEYGEN_CALLBACK_URL=

REMOTION_RENDER_URL=
REMOTION_WEBHOOK_SECRET=

WEBHOOK_URL=
WEBHOOK_SECRET=

# Public base URL of this API (builds HeyGen callback_url)
PUBLIC_BASE_URL=

ASSET_STORAGE_DIR=data/assets
WEBHOOK_OUTBOX_MAX_ATTEMPTS=8
WEBHOOK_OUTBOX_BASE_DELAY_SECONDS=2.0
IDEMPOTENCY_TTL_SECONDS=3600
STUCK_JOB_SECONDS=900

# Phase 2 worker
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=5
WORKER_RECONCILE_INTERVAL_SECONDS=60.0
WORK_QUEUE_STALE_SECONDS=900
OUTBOX_STALE_SECONDS=900

# Phase 3 — content quality + approval gate
# Second HeyGen 16:9 render ONLY when true AND job include_horizontal
HEYGEN_ALLOW_DUAL_FORMAT=false
# Phase 3 default: never auto-advance to delivered from outbox (approval required)
AUTO_DELIVER_ON_OUTBOX_SUCCESS=false

# Phase 4 — scheduling + distribution
SCHEDULE_POSTS_PER_DAY=3
SCHEDULE_TIMEZONE=America/Los_Angeles
# Comma-separated or JSON list of topics for schedule-tick
SCHEDULE_TOPICS=morning hustle tips,outreach that converts,ship today not tomorrow
SCHEDULE_DURATION_SECONDS=30
SCHEDULE_PLATFORMS=tiktok,reels,shorts
# true = schedule tick also enqueues generate_avatar (burns HeyGen when worker runs)
SCHEDULE_ENQUEUE_AVATAR=false
DISTRIBUTE_STAGING_DIR=data/staging

# YouTube Shorts (OAuth). Leave empty for safe staging-only distribute (no network).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public — default private even when live upload succeeds
YOUTUBE_PRIVACY_STATUS=private

# --- Image quality gate (hard) ---
IMAGE_GATE_MAX_ATTEMPTS=3
IMAGE_GATE_FAIL_CLOSED=true
IMAGE_GATE_BREAK_GLASS=false
IMAGE_SCORER_PROVIDER=gemini
IMAGE_SCORER_GEMINI_API_KEY=
GEMINI_API_KEY=
IMAGE_SCORER_GEMINI_MODEL=gemini-2.0-flash
IMAGE_SCORER_GROK_API_KEY=
XAI_API_KEY=
IMAGE_SCORER_GROK_MODEL=grok-2-vision-1212
IMAGE_SCORER_TIMEOUT_SECONDS=60
IMAGE_SCORER_DAILY_BUDGET=200
ACTIVE_REFERENCE_SET_PATH=reference_images/ACTIVE_REFERENCE_SET.json
